if(NOT DEFINED TOOL OR NOT DEFINED TEST_ROOT)
  message(FATAL_ERROR "Set TOOL and TEST_ROOT")
endif()
file(MAKE_DIRECTORY "${TEST_ROOT}")
set(source "${TEST_ROOT}/not-the-pinned-model.bin")
file(WRITE "${source}" "abc")
execute_process(COMMAND "${TOOL}" --verify --model "${source}" --encoder "${TEST_ROOT}/encoder.xml"
  RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE errors)
file(REMOVE "${source}")
if(result EQUAL 0 OR output MATCHES "LUMA_ENCODER_VERIFIED=")
  message(FATAL_ERROR "Verification acknowledged an unauthenticated source model")
endif()
if(NOT errors MATCHES "size does not match pinned Q5 model")
  message(FATAL_ERROR "Verification did not reach the shared pinned-source validator: ${errors}")
endif()
