#include <winver.h>
VS_VERSION_INFO VERSIONINFO
 FILEVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,@LUMA_BUILD_NUMBER@
 PRODUCTVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,@LUMA_BUILD_NUMBER@
 FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
 FILEFLAGS 0
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE 0
BEGIN
 BLOCK "StringFileInfo"
 BEGIN
  BLOCK "040904B0"
  BEGIN
   VALUE "CompanyName", "LumaPlayer contributors\0"
   VALUE "FileDescription", "LumaPlayer\0"
   VALUE "FileVersion", "@LUMA_VERSION@\0"
   VALUE "InternalName", "LumaPlayer\0"
   VALUE "OriginalFilename", "LumaPlayer.exe\0"
   VALUE "ProductName", "LumaPlayer\0"
   VALUE "ProductVersion", "@LUMA_VERSION@\0"
  END
 END
 BLOCK "VarFileInfo"
 BEGIN
  VALUE "Translation", 0x0409, 1200
 END
END
